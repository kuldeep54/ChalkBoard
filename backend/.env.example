PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/chalkboard?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
ACCESS_TOKEN_EXPIRE=15m

# Comma-separated list of allowed browser origins (e.g. Expo web dev servers)
CORS_ORIGIN=http://localhost:8081,http://localhost:19006

# SMTP (leave blank to log emails to the server console in dev mode)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=ChalkBoard <no-reply@chalkboard.app>

# Frontend deep link base for email links (reset-password / verify-email).
# Leave blank in Expo Go dev to auto-derive exp://HOST:8081/--/ links.
# Set to chalkboard:// for native builds.
AUTH_BASE_URL=
